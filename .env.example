# Copiar a .env para desarrollo local con Floci
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Recursos creados por bootstrap (infrastructure/bootstrap/bootstrap.ps1)
S3_BUCKET_INPUT=placas-proyecto-input
S3_BUCKET_OUTPUT=placas-proyecto-output
S3_BUCKET_ML=placas-proyecto-ml
SQS_QUEUE_NAME=placas-jobs
SQS_DLQ_NAME=placas-jobs-dlq
DYNAMODB_TABLE_JOBS=placas-jobs
DYNAMODB_TABLE_PLACAS=placas-results
ECR_REPOSITORY=placas-worker
