{
  "family": "placas-worker",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "cpu": "1024",
  "memory": "2048",
  "containerDefinitions": [
    {
      "name": "placas-worker",
      "image": "placas-worker:latest",
      "essential": true,
      "environment": [
        {"name": "AWS_ENDPOINT_URL", "value": "http://host.docker.internal:4566"},
        {"name": "AWS_DEFAULT_REGION", "value": "us-east-1"},
        {"name": "AWS_ACCESS_KEY_ID", "value": "test"},
        {"name": "AWS_SECRET_ACCESS_KEY", "value": "test"},
        {"name": "S3_BUCKET_INPUT", "value": "placas-proyecto-input"},
        {"name": "S3_BUCKET_OUTPUT", "value": "placas-proyecto-output"},
        {"name": "SQS_QUEUE_NAME", "value": "placas-jobs"},
        {"name": "DYNAMODB_TABLE_PLACAS", "value": "placas-results"},
        {"name": "WORKER_IDLE_ROUNDS", "value": "5"},
        {"name": "CAPTCHA_MODEL_PATH", "value": "/app/models/captcha_model.keras"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/placas-worker",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
